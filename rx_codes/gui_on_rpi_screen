def draw_top_crops(proba_dict):
    tag = "crops"
    cv.delete(tag)


    rx = RIGHT_X + 10
    ry = BOTTOM_Y + 24
    rw = RIGHT_W - 18
    rh = BOTTOM_H - 30


    top = sorted(proba_dict.items(), key=lambda x: x[1], reverse=True)[:8]
    if not top:
        return


    row_h  = rh // len(top)
    max_p  = top[0][1] if top[0][1] > 0 else 1


    bar_colors = [
        C["accent1"], C["accent2"], C["accent5"], C["accent3"],
        C["accent6"], "#f472b6", C["accent7"], C["accent4"],
    ]


    for i, (crop, prob) in enumerate(top):
        y      = ry + i * row_h
        bar_y  = y + row_h//2 - 7
        bar_h  = 13
        col    = bar_colors[i % len(bar_colors)]
        dot_c  = CROP_COLOR_TAG.get(crop.lower(), col)
        disp   = CROP_DISPLAY.get(crop.lower(), crop.upper())


        bx0    = rx + 130
        bx1    = rx + rw - 38
        bar_w  = int((bx1-bx0) * (prob/max_p))


        # rank badge
        cv.create_oval(rx+2, bar_y+1, rx+20, bar_y+bar_h-1,
                       fill=C["dim2"], outline=col, width=1, tags=tag)
        cv.create_text(rx+11, bar_y+bar_h//2, text=str(i+1),
                       anchor="center", fill=col,
                       font=F(7,"bold"), tags=tag)


        # coloured dot before crop name
        cv.create_oval(rx+24, bar_y+bar_h//2-4,
                       rx+32, bar_y+bar_h//2+4,
                       fill=dot_c, outline="", tags=tag)


        # crop name
        cv.create_text(rx+36, bar_y+bar_h//2, text=disp,
                       anchor="w", fill=C["white"],
                       font=F(8,"bold"), tags=tag)


        # bar bg
        cv.create_rectangle(bx0, bar_y, bx1, bar_y+bar_h,
                             fill=C["bar_bg"], outline=C["border"],
                             width=1, tags=tag)
        # bar fill + glow tip
        if bar_w > 2:
            fx1 = bx0 + min(bar_w, bx1-bx0)
            cv.create_rectangle(bx0, bar_y, fx1, bar_y+bar_h,
                                 fill=col, outline="", tags=tag)
            cv.create_rectangle(fx1-3, bar_y+1, fx1, bar_y+bar_h-1,
                                 fill=C["white"], outline="", tags=tag)


