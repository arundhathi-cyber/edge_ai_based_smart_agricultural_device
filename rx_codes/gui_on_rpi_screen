def hex_points(cx, cy, r, offset_angle=0):
    pts = []
    for i in range(6):
        a = math.radians(60 * i + offset_angle)
        pts.extend([cx + r * math.cos(a), cy + r * math.sin(a)])
    return pts


def draw_hexagon(cx, cy, r, fill="", outline="#1a4028", width=1,
                 tag="static", offset=30):
    pts = hex_points(cx, cy, r, offset)
    cv.create_polygon(pts, fill=fill, outline=outline,
                      width=width, tags=tag)


def draw_rounded_rect(x0, y0, x1, y1, r=8, fill=C["card"],
                      outline=C["border"], width=1, tag="static"):
    cv.create_rectangle(x0+r, y0, x1-r, y1,   fill=fill, outline="", tags=tag)
    cv.create_rectangle(x0, y0+r, x1, y1-r,   fill=fill, outline="", tags=tag)
    for ox, oy in [(x0+r,y0+r),(x1-r,y0+r),(x0+r,y1-r),(x1-r,y1-r)]:
        cv.create_oval(ox-r,oy-r,ox+r,oy+r,   fill=fill, outline="", tags=tag)
    if outline and width:
        cv.create_line(x0+r,y0, x1-r,y0,      fill=outline, width=width, tags=tag)
        cv.create_line(x0+r,y1, x1-r,y1,      fill=outline, width=width, tags=tag)
        cv.create_line(x0,y0+r, x0,y1-r,      fill=outline, width=width, tags=tag)
        cv.create_line(x1,y0+r, x1,y1-r,      fill=outline, width=width, tags=tag)
        cv.create_arc(x0,    y0,    x0+2*r,y0+2*r, start=90,  extent=90,
                      style="arc", outline=outline, width=width, tags=tag)
        cv.create_arc(x1-2*r,y0,    x1,    y0+2*r, start=0,   extent=90,
                      style="arc", outline=outline, width=width, tags=tag)
        cv.create_arc(x0,    y1-2*r,x0+2*r,y1,     start=180, extent=90,
                      style="arc", outline=outline, width=width, tags=tag)
        cv.create_arc(x1-2*r,y1-2*r,x1,    y1,     start=270, extent=90,
                      style="arc", outline=outline, width=width, tags=tag)


def draw_arc_gauge(cx, cy, r, pct, color, bg_color="#1e3828",
                   width=7, tag=""):
    kw = {"tags": tag} if tag else {}
    cv.create_arc(cx-r, cy-r, cx+r, cy+r,
                  start=220, extent=-260,
                  style="arc", outline=bg_color, width=width, **kw)
    extent = -260 * min(max(pct, 0), 1)
    if abs(extent) > 1:
        cv.create_arc(cx-r, cy-r, cx+r, cy+r,
                      start=220, extent=extent,
                      style="arc", outline=color, width=width, **kw)
        cv.create_arc(cx-r+2, cy-r+2, cx+r-2, cy+r-2,
                      start=220, extent=extent,
                      style="arc", outline=color,
                      width=max(1, width-5), **kw)


def draw_sparkline(x0, y0, w, h, values, color, tag=""):
    if len(values) < 2:
        return
    mn, mx = min(values), max(values)
    rng = (mx - mn) or 1
    pts = []
    for i, v in enumerate(values):
        px = x0 + i * w / (len(values)-1)
        py = y0 + h - (v - mn) / rng * h
        pts.extend([px, py])
    kw = {"tags": tag} if tag else {}
    shadow = [pts[j] if j % 2 == 0 else pts[j]+1
              for j in range(len(pts))]
    cv.create_line(*shadow, fill=C["dim"], width=2, smooth=True, **kw)
    cv.create_line(*pts,    fill=color,    width=2, smooth=True, **kw)


def dot_grid(x0, y0, x1, y1, step=22, color="#0e2016", tag="static"):
    for x in range(x0, x1, step):
        for y in range(y0, y1, step):
            cv.create_oval(x-1,y-1,x+1,y+1,
                           fill=color, outline="", tags=tag)


