# ──────────────────────────────────────────────
# READ SENSOR DATA
# ──────────────────────────────────────────────
def read_sensor():
    defaults = {"temp":28.5,"hum":65,"ph":6.5,"N":30,"P":20,"K":40,"moisture":45.0}
    try:
        df = pd.read_csv(CSV_PATH)
        df.columns = df.columns.str.strip().str.lower()
        row = df.iloc[-1]
        def get_val(col_name, default):
            try:
                return float(row[col_name])
            except Exception:
                return default
        return {
            "temp":     get_val("temp",     defaults["temp"]),
            "hum":      get_val("hum",      defaults["hum"]),
            "ph":       get_val("ph",       defaults["ph"]),
            "N":        get_val("n",        defaults["N"]),
            "P":        get_val("p",        defaults["P"]),
            "K":        get_val("k",        defaults["K"]),
            "moisture": get_val("soil", defaults["moisture"]),
        }
    except Exception:
        return defaults


# ──────────────────────────────────────────────
# PREDICT  (moisture not passed to model)
# ──────────────────────────────────────────────
def predict(vals):
    if model is None:
        return ("rice", 94.5, {"rice":0.945,"maize":0.82,"chickpea":0.6,
                                "lentil":0.4,"mango":0.3,"banana":0.2,
                                "coffee":0.15,"cotton":0.1})
    try:
        features = pd.DataFrame([[
            vals["N"], vals["P"], vals["K"],
            vals["temp"], vals["hum"], vals["ph"], RAINFALL_FIXED
        ]], columns=["N","P","K","temperature","humidity","ph","rainfall"])
        proba      = model.predict_proba(features)[0]
        classes    = model.classes_
        proba_dict = {c: float(p) for c, p in zip(classes, proba)}
        best       = max(proba_dict, key=proba_dict.get)
        suitability = proba_dict[best] * 100
        return best, suitability, proba_dict
    except Exception as e:
        print(f"[WARN] predict error: {e}")
        return ("rice", 0.0, {})


