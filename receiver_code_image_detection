import time
import spidev
import RPi.GPIO as GPIO




# =====================================================
# GPIO / SPI
# =====================================================


RST = 5


GPIO.setwarnings(False)
GPIO.setmode(GPIO.BCM)


GPIO.setup(RST, GPIO.OUT)




spi = spidev.SpiDev()
spi.open(0, 0)


spi.max_speed_hz = 100000
spi.mode = 0b00




# =====================================================
# LoRa Register Functions
# =====================================================


def write_reg(addr, val):
    spi.xfer2([addr | 0x80, val])




def read_reg(addr):
    return spi.xfer2([addr & 0x7F, 0])[1]




def reset():
    GPIO.output(RST, 0)
    time.sleep(0.1)


    GPIO.output(RST, 1)
    time.sleep(0.1)




# =====================================================
# RESET LoRa
# =====================================================


reset()




# =====================================================
# CHECK LoRa HARDWARE
# =====================================================


version = read_reg(0x42)


if version != 0x12:


    print("Hardware not found! Check LoRa wiring.")
    print("Read version:", hex(version))


    spi.close()
    GPIO.cleanup()


    exit()




print("LoRa hardware detected")




# =====================================================
# LoRa CONFIGURATION
# SAME AS YOUR OLD WORKING RECEIVER
# =====================================================


# Sleep mode
write_reg(0x01, 0x80)




# -----------------------------------------------------
# Frequency = 433 MHz
# -----------------------------------------------------


write_reg(0x06, 0x6C)
write_reg(0x07, 0x40)
write_reg(0x08, 0x00)




# -----------------------------------------------------
# Bandwidth = 125 kHz
# Coding Rate = 4/5
# -----------------------------------------------------


write_reg(0x1D, 0x72)




# -----------------------------------------------------
# Spreading Factor = 7
# -----------------------------------------------------


write_reg(0x1E, 0x74)




# -----------------------------------------------------
# LNA
# -----------------------------------------------------


write_reg(0x26, 0x04)




# -----------------------------------------------------
# Sync Word = 0x12
# -----------------------------------------------------


write_reg(0x39, 0x12)




# -----------------------------------------------------
# FIFO
# -----------------------------------------------------


write_reg(0x33, 0x27)




# -----------------------------------------------------
# Clear IRQ flags
# -----------------------------------------------------


write_reg(0x12, 0xFF)




# -----------------------------------------------------
# Continuous Receive Mode
# -----------------------------------------------------


write_reg(0x01, 0x85)




# =====================================================
# READY
# =====================================================


print("================================")
print("LoRa RECEIVER READY")
print("Waiting for leaf result...")
print("================================")




# =====================================================
# MAIN RECEIVE LOOP
# =====================================================


try:


    while True:


        # Read IRQ flags
        irq = read_reg(0x12)




        # =================================================
        # RxDone
        # =================================================


        if irq & 0x40:




            # =================================================
            # CRC ERROR
            # =================================================


            if irq & 0x20:


                print("CRC Error")




            else:


                # -------------------------------------------------
                # Get packet length
                # -------------------------------------------------


                length = read_reg(0x13)




                # -------------------------------------------------
                # Get current FIFO address
                # -------------------------------------------------


                current_addr = read_reg(0x10)




                # -------------------------------------------------
                # Set FIFO pointer
                # -------------------------------------------------


                write_reg(0x0D, current_addr)




                # -------------------------------------------------
                # Read packet
                # -------------------------------------------------


                data = spi.xfer2(
                    [0x00] + [0] * length
                )




                # -------------------------------------------------
                # Convert packet to string
                # -------------------------------------------------


                msg = bytes(
                    data[1:]
                ).decode(
                    errors="ignore"
                ).strip()




                # =================================================
                # PARSE RESULT
                # =================================================


                try:


                    parts = msg.split(",")




                    # We expect:
                    #
                    # healthy,0.92341
                    #
                    # OR
                    #
                    # unhealthy,0.79600
                    #


                    if len(parts) < 2:
                        raise ValueError("Invalid packet format")




                    status = parts[0].strip().lower()


                    confidence = float(
                        parts[1].strip()
                    )




                    # -------------------------------------------------
                    # Clean status
                    # -------------------------------------------------


                    if "unhealthy" in status:


                        status = "unhealthy"


                    elif "healthy" in status:


                        status = "healthy"


                    else:


                        raise ValueError(
                            "Unknown leaf status"
                        )




                    # -------------------------------------------------
                    # Convert confidence to percentage
                    # -------------------------------------------------


                    confidence_percent = confidence * 100




                    # =================================================
                    # FINAL TERMINAL OUTPUT
                    # =================================================


                    print()


                    print(
                        "RECEIVED :",
                        status.upper()
                    )


                    print(
                        "CONFIDENCE :",
                        f"{confidence_percent:.2f}%"
                    )


                    print(
                        "--------------------------------"
                    )




                except Exception as e:


                    print()
                    print("Invalid packet received:", msg)
                    print("Error:", e)
                    print("--------------------------------")




            # =================================================
            # CLEAR IRQ FLAGS
            # =================================================


            write_reg(0x12, 0xFF)




            # =================================================
            # RETURN TO CONTINUOUS RECEIVE
            # =================================================


            write_reg(0x01, 0x85)




        # Small delay
        time.sleep(0.01)




# =====================================================
# CLEANUP
# =====================================================


except KeyboardInterrupt:


    print("\nReceiver stopped.")




finally:


    spi.close()
    GPIO.cleanup()
